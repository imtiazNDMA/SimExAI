# ==========================================
# SimExAI Environment Configuration
# ==========================================

# ------------------------------------------
# Pinecone Vector Database
# ------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=simexai

# ------------------------------------------
# LM Studio LLM Configuration (OpenAI-compatible API)
# ------------------------------------------
# Start the server from LM Studio's Developer / Local Server tab.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b
# LM Studio ignores the key's value, but the OpenAI client requires one.
LMSTUDIO_API_KEY=lm-studio

# Chat generation
LMSTUDIO_TIMEOUT_SECONDS=180
LMSTUDIO_TEMPERATURE=0.45
LMSTUDIO_TOP_P=0.9
# NOTE: gemma-4 is a reasoning model — it spends 100-1700 tokens thinking
# before it emits any visible answer, and max_tokens covers both. Budgets
# set too low return an EMPTY response rather than a short one.
LMSTUDIO_MAX_TOKENS=3000

# Scenario extraction (deterministic, long structured output)
LMSTUDIO_UPLOAD_TIMEOUT_SECONDS=600
LMSTUDIO_UPLOAD_TEMPERATURE=0
LMSTUDIO_UPLOAD_MAX_TOKENS=16000

# ------------------------------------------
# Kokoro TTS (Text-to-Speech)
# ------------------------------------------
# Language code ('a' = American English, 'b' = British English, etc.)
KOKORO_LANG=a
# Voice model
KOKORO_VOICE=af_heart

# ------------------------------------------
# Document Parsing & Vision Settings
# ------------------------------------------
SIMEXAI_VISION_DPI=120
SIMEXAI_VISION_JPEG_QUALITY=70
