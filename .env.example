# ==========================================
# SimExAI Environment Configuration
# ==========================================

# ------------------------------------------
# Pinecone Vector Database
# ------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=simexai

# ------------------------------------------
# Ollama LLM Configuration
# ------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_UPLOAD_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.45
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=700

# ------------------------------------------
# Kokoro TTS (Text-to-Speech)
# ------------------------------------------
# Language code ('a' = American English, 'b' = British English, etc.)
KOKORO_LANG=a
# Voice model
KOKORO_VOICE=af_heart

# ------------------------------------------
# Document Parsing & Vision Settings
# ------------------------------------------
SIMEXAI_VISION_DPI=120
SIMEXAI_VISION_JPEG_QUALITY=70
